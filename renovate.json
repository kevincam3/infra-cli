{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":configMigration"],
  "assignees": ["kevincam3"],
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "automergeStrategy": "rebase",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch"
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "Renovate cannot see release dates for lock file maintenance (pnpm does the resolving), so its stability check never passes and the branch never automerges. pnpm's own minimumReleaseAge in pnpm-workspace.yaml enforces the 48h hold instead",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "groupName": "trusted npm packages",
      "matchPackageNames": [
        "@commitlint/**",
        "@semantic-release/**",
        "pnpm",
        "figlet",
        "vite-plus",
        "@voidzero-dev/vite-plus-core"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "branch",
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "branch",
      "rebaseWhen": "behind-base-branch"
    }
  ]
}
